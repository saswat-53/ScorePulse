# Dependencies
node_modules/

# Secrets (never commit; commit the *.example files instead)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Signing keys (losing the APK key breaks updates for every user: back it up elsewhere)
*.jks
*.keystore
*.p12
*.pem
*.key
google-services.json
credentials.json

# Expo / React Native
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*
*.tsbuildinfo

# Native build output (generated by prebuild / local builds)
app/android/
app/ios/
*.apk
*.aab

# Cloudflare Workers / Wrangler
.wrangler/

# Logs and OS junk
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db

# Editor / local tooling
.vscode/*
!.vscode/extensions.json
.idea/
.claude/settings.local.json

# Local scratch: saved provider responses can be huge (live=all is ~4 MB)
/scratch/
