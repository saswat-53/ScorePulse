# Copy to `.env`. Never commit `.env`.
# Anything prefixed EXPO_PUBLIC_ is bundled into the APK and readable by anyone who
# installs it, so only public values belong here. No provider keys, no Clerk secret key.

# Base URL of the Hono API (local wrangler dev, or the deployed *.workers.dev URL).
# On a real phone use your PC's LAN IP, not localhost, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Clerk publishable key (pk_...) is safe to ship in the app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Sentry (app project DSN)
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
