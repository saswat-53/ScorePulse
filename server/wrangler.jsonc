{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scorepulse-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat is required by @sentry/cloudflare
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static matchday windows in UTC (ADR 0010): Friday to Monday 11:00-22:59, Tuesday to Thursday 17:00-22:59.
  // Day names, because Cloudflare numbers weekdays differently from standard cron.
  // The poller runs on a 5-minute beat and decides itself whether anything is due (ADR 0016).
  "triggers": {
    "crons": [
      "*/5 11-22 * * FRI,SAT,SUN,MON",
      "*/5 17-22 * * TUE,WED,THU",
      // 06:00 to 06:20 UTC is the snapshot sync (#7), one league per run; the rest of 06:00-09:55 is the archive's catch-up
      // (#23), one match per run. 23:30 UTC is the evening sync. Keep both in step with src/schedule.ts.
      "*/5 6-9 * * *",
      "30,35,40,45,50 23 * * *"
    ]
  },

  // Non-secret config. Secrets (DATABASE_URL, CLERK_SECRET_KEY, ...) are set with `wrangler secret put`.
  "vars": {
    // API-Football requests go through the relay (relay/, on Vercel): from the Worker's own Cloudflare address they were
    // refused for rate limit in most runs (#26). Remove this line to call API-Football directly again.
    "API_FOOTBALL_BASE_URL": "https://scorepulse-relay.vercel.app/api"
  }
}
