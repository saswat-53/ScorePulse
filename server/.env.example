# Used only by tooling that runs on your machine, NOT by the deployed Worker
# (the Worker reads secrets from `.dev.vars` locally and `wrangler secret` in production).
# Copy to `.env`. Never commit `.env`.

# Neon: DIRECT connection string (no "-pooler" in the host), used by drizzle-kit migrations
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
