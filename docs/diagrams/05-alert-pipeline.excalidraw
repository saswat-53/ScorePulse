      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1795254055942,
      "link": null,
      "locked": false,
      "text": "After 3 failed attempts a row stays failed and is never sent again, so retries cannot eat the day's quota.\nA retry goes only to the phones that did not get it yet (delivered_to), so nobody gets the same alert twice.\nA goal alert still waiting when VAR cancels the goal is marked skipped by queueAlerts: nobody hears about a goal that never counted.",
      "originalText": "After 3 failed attempts a row stays failed and is never sent again, so retries cannot eat the day's quota.\nA retry goes only to the phones that did not get it yet (delivered_to), so nobody gets the same alert twice.\nA goal alert still waiting when VAR cancels the goal is marked skipped by queueAlerts: nobody hears about a goal that never counted.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
