      "updated": 1795254055942,
      "link": null,
      "locked": false,
      "text": "Unique on (user_id, event_key), so the\nsame alert is never queued twice\nevent_key: fixture:42:event:7\nstatus: pending, sent, failed, skipped\npayload: the alert's content, saved\nwith the row so a send needs no lookup\nattempts: failed sends so far\ndelivered_to: tokens that already got it",
      "originalText": "Unique on (user_id, event_key), so the\nsame alert is never queued twice\nevent_key: fixture:42:event:7\nstatus: pending, sent, failed, skipped\npayload: the alert's content, saved\nwith the row so a send needs no lookup\nattempts: failed sends so far\ndelivered_to: tokens that already got it",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
