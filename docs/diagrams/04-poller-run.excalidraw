      "updated": 1795253531629,
      "link": null,
      "locked": false,
      "text": "Only when all 100 requests are used and a match is due\nOne request every 10 min: score and status only, no events\nA score that went up owes an alert\nIf it fails too, nothing is polled and the app shows 'updates paused'",
      "originalText": "Only when all 100 requests are used and a match is due\nOne request every 10 min: score and status only, no events\nA score that went up owes an alert\nIf it fails too, nothing is polled and the app shows 'updates paused'",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
