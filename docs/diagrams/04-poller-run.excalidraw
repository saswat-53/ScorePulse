      "boundElements": [],
      "updated": 1795253531629,
      "link": null,
      "locked": false,
      "text": "A step that has nothing to do is skipped, so a quiet beat is just step 1 and the run ends.\nRequests to API-Football in one beat: 0 or 1 for step 3, then up to 3 lookups and up to 3 extra fetches in step 6. Each is counted in poll_state.",
      "originalText": "A step that has nothing to do is skipped, so a quiet beat is just step 1 and the run ends.\nRequests to API-Football in one beat: 0 or 1 for step 3, then up to 3 lookups and up to 3 extra fetches in step 6. Each is counted in poll_state.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
