      "boundElements": [],
      "updated": 1795250624857,
      "link": null,
      "locked": false,
      "text": "A cron run is not a request: nobody waits for an answer. A run that finds nothing to do ends without calling a provider.\nColours: blue = sync, purple = archive, green = poll. Each arrow on the right is one job; the left shows the four triggers in wrangler.jsonc.",
      "originalText": "A cron run is not a request: nobody waits for an answer. A run that finds nothing to do ends without calling a provider.\nColours: blue = sync, purple = archive, green = poll. Each arrow on the right is one job; the left shows the four triggers in wrangler.jsonc.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
