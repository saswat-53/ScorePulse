      "updated": 1795250624857,
      "link": null,
      "locked": false,
      "text": "Reads the cron text and the time.\n\nnight cron → sync\nmorning cron, before 06:25 → sync\nmorning cron, after that → archive\nany other cron → poll\n\nFor a sync, the minute picks the\nleague: 0, 5, 10, 15, 20 → slot 0 to 4\n\nschedule.ts keeps these strings equal\nto the ones in wrangler.jsonc",
      "originalText": "Reads the cron text and the time.\n\nnight cron → sync\nmorning cron, before 06:25 → sync\nmorning cron, after that → archive\nany other cron → poll\n\nFor a sync, the minute picks the\nleague: 0, 5, 10, 15, 20 → slot 0 to 4\n\nschedule.ts keeps these strings equal\nto the ones in wrangler.jsonc",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
